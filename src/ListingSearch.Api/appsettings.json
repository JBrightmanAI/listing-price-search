{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ListingData": {
    "FilePath": "Data/sample_listings.json"
  },
  "Scoring": {
    "BudgetWeight": 0.7,
    "RecencyWeight": 0.3,
    "RecencyHalfLifeDays": 30
  },
