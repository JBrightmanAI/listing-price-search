# Frontend settings. Copy to .env.local and adjust:  cp .env.example .env.local
#
# WARNING: anything prefixed VITE_ is compiled into the JavaScript bundle and visible to every user.
# Never put secrets here.

# ---- Development server only (read by vite.config.ts, not shipped to the browser) ----------
# Where `bun run dev` proxies /api and /health.
API_URL=http://127.0.0.1:5001

# ---- Shipped to the browser ------------------------------------------------------------------
# Base URL for API calls. Leave empty to call the same origin (dev proxy, or nginx in Docker).
# Set only when the API is hosted on a different origin, e.g. https://api.example.com
VITE_API_BASE_URL=
