# Docker Compose settings. Copy to .env and adjust:  cp .env.example .env
# Compose reads .env automatically; every value here also has a default in docker-compose.yml,
# so the app runs without a .env file.

# Host port for the web container (the only published port).
WEB_PORT=8080

# Search API requests allowed per client IP per minute.
RATE_LIMIT_PER_MINUTE=60

# Relevance scoring weights. Must be between 0 and 1 and add up to 1, or the API refuses to start.
SCORING_BUDGET_WEIGHT=0.7
SCORING_RECENCY_WEIGHT=0.3

# ASP.NET Core environment for the api container: Production (JSON logs, HSTS) or Development.
ASPNETCORE_ENVIRONMENT=Production
